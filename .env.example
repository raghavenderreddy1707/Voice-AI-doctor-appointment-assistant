# GEMINI_API_KEY: Required for Gemini AI API calls (both built-in voice server and Python Pipecat pipeline).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Required when running the standalone Python Pipecat pipeline (ElevenLabs STT + TTS).
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: Optional ElevenLabs voice ID for the clinic receptionist (defaults to Rachel).
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# CLINIC_DB_PATH: Optional path to the shared SQLite database (defaults to ./data/clinic.db).
CLINIC_DB_PATH="./data/clinic.db"
